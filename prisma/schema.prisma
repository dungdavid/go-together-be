// back-end/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perspective {
  shared
  partnerA
  partnerB
}

model Place {
  id            String          @id @default(uuid())
  name          String
  lat           Float
  lng           Float
  region        String?
  visitedAt     DateTime?
  coverPhotoUrl String?
  notes         String?
  perspective   Perspective     @default(shared)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  checklist     ChecklistItem[]
  foodList      FoodItem[]
  photos        Photo[]
}

model ChecklistItem {
  id        String   @id @default(uuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodItem {
  id        String   @id @default(uuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  rating    Int?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id        String   @id @default(uuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RequestLog {
  id         String   @id @default(uuid())
  method     String
  path       String
  statusCode Int
  durationMs Int
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}
